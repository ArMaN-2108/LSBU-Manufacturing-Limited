\cf2 Highest and lowest shifts worked last month::\
\
\pard\pardeftab720\sl337\partightenfactor0
\cf3 \expnd0\expndtw0\kerning0
WITH ShiftCount AS (\
\'a0\'a0\'a0 SELECT \
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 Operator_ID,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 COUNT(*) AS Total_Shifts\
\'a0\'a0\'a0 FROM Shift\
\'a0\'a0\'a0 WHERE \
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 Shift_Date >= DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()) - 1, 1)\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 AND Shift_Date < DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1)\
\'a0\'a0\'a0 GROUP BY Operator_ID\
),\
MaxMin AS (\
\'a0\'a0\'a0 SELECT \
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 MAX(Total_Shifts) AS MaxShifts,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 MIN(Total_Shifts) AS MinShifts\
\'a0\'a0\'a0 FROM ShiftCount\
)\
SELECT \
\'a0\'a0\'a0 sc.Operator_ID,\
\'a0\'a0\'a0 e.Name,\
\'a0\'a0\'a0 sc.Total_Shifts,\
\'a0\'a0\'a0 CASE \
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 WHEN sc.Total_Shifts = mm.MaxShifts THEN 'Most Shifts'\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 WHEN sc.Total_Shifts = mm.MinShifts THEN 'Least Shifts'\
\'a0\'a0\'a0 END AS Shift_Category\
FROM ShiftCount sc\
JOIN MaxMin mm ON sc.Total_Shifts = mm.MaxShifts OR sc.Total_Shifts = mm.MinShifts\
JOIN Employee e ON sc.Operator_ID = e.Employee_ID;\
\
\cf2 Specific parts produced by machine::\
\
\cf3 SELECT \
\'a0\'a0\'a0 pi.Machine_ID,\
\'a0\'a0\'a0 p.Product_Name,\
\'a0\'a0\'a0 pi.Manufacture_DateTime\
FROM Product_Instance pi\
JOIN Product p ON pi.Product_ID = p.Product_ID\
WHERE \
\'a0\'a0\'a0 p.Product_Name IN ('Flywheel', 'Clutch Plate', 'Pressure Plate')\
\'a0\'a0\'a0 AND pi.Manufacture_DateTime >= DATEADD(DAY, -3, GETDATE())\
ORDER BY \
\'a0\'a0\'a0 pi.Machine_ID, \
\'a0\'a0\'a0 pi.Manufacture_DateTime;\
\cf2 \
Machines with more than 3 maintenance records::\
\
\cf3 SELECT \
\'a0\'a0\'a0 m.Machine_ID,\
\'a0\'a0\'a0 COUNT(*) AS Maintenance_Count\
FROM Maintenance m\
GROUP BY m.Machine_ID\
HAVING COUNT(*) > 3\
ORDER BY Maintenance_Count DESC;\
