\cf2 \outl0\strokewidth0 \strokec3 business rule that an employee\'92s pay may not exceed their manager\'92s pay::\
\
\pard\pardeftab720\sl337\partightenfactor0
\cf3 \outl0\strokewidth0 CREATE PROCEDURE Check_Salary_Violations\
AS\
BEGIN\
\'a0\'a0\'a0 SELECT \
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 e.Employee_ID,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 e.Name AS Employee_Name,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 e.Salary AS Employee_Salary,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 mgr.Employee_ID AS Manager_ID,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 mgr.Name AS Manager_Name,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 mgr.Salary AS Manager_Salary,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 e.Department_ID\
\'a0\'a0\'a0 FROM Employee e\
\'a0\'a0\'a0 JOIN Employee mgr \
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 ON e.Department_ID = mgr.Department_ID AND mgr.Is_Manager = 1\
\'a0\'a0\'a0 WHERE e.Is_Manager = 0\
\'a0\'a0\'a0\'a0\'a0 AND e.Salary > mgr.Salary;\
END;\
\pard\pardeftab720\partightenfactor0
\cf2 \
Execution::\
\
\pard\pardeftab720\sl337\partightenfactor0
\cf3 EXEC Check_Salary_Violations;\
\pard\pardeftab720\partightenfactor0
\cf2 \
Dynamic salary report::\
\
\pard\pardeftab720\sl337\partightenfactor0
\cf3 CREATE PROCEDURE Get_Salary_Report_By_Period\
\'a0\'a0\'a0 @PeriodType VARCHAR(10) -- Accepts: 'WEEK', 'MONTH', 'QUARTER'\
AS\
BEGIN\
\'a0\'a0\'a0 SET NOCOUNT ON;\
\'a0\
\'a0\'a0\'a0 -- Temporary date filter\
\'a0\'a0\'a0 DECLARE @StartDate DATE;\
\'a0\
\'a0\'a0\'a0 -- Calculate start date based on period type\
\'a0\'a0\'a0 IF UPPER(@PeriodType) = 'WEEK'\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 SET @StartDate = DATEADD(DAY, -7, GETDATE());\
\'a0\'a0\'a0 ELSE IF UPPER(@PeriodType) = 'MONTH'\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 SET @StartDate = DATEFROMPARTS(YEAR(GETDATE()), MONTH(GETDATE()), 1);\
\'a0\'a0\'a0 ELSE IF UPPER(@PeriodType) = 'QUARTER'\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 SET @StartDate = DATEADD(MONTH, -3, GETDATE());\
\'a0\'a0\'a0 ELSE\
\'a0\'a0\'a0 BEGIN\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 PRINT 'Invalid period type. Use WEEK, MONTH, or QUARTER.';\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 RETURN;\
\'a0\'a0\'a0 END\
\'a0\
\'a0\'a0\'a0 -- Main report\
\'a0\'a0\'a0 SELECT \
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 d.Department_Name,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 e.Employee_ID,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 e.Name AS Employee_Name,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 e.Job_Title,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 e.Salary,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 e.Department_ID,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 -- For flexibility: assume all employees were "added" recently (since we don't have Hire_Date)\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 GETDATE() AS Report_Generated_On\
\'a0\'a0\'a0 FROM Employee e\
\'a0\'a0\'a0 JOIN Department d ON e.Department_ID = d.Department_ID\
\'a0\'a0\'a0 -- Uncomment below if you have Hire_Date or Shift_Date field for real filters\
\'a0\'a0\'a0 -- WHERE e.Hire_Date >= @StartDate\
\'a0\'a0\'a0 ORDER BY d.Department_Name, e.Name;\
\'a0\
\'a0\'a0\'a0 -- Department totals\
\'a0\'a0\'a0 SELECT \
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 d.Department_Name,\
\'a0\'a0\'a0\'a0\'a0\'a0\'a0 SUM(e.Salary) AS Total_Salary\
\'a0\'a0\'a0 FROM Employee e\
\'a0\'a0\'a0 JOIN Department d ON e.Department_ID = d.Department_ID\
\'a0\'a0\'a0 -- WHERE e.Hire_Date >= @StartDate\
\'a0\'a0\'a0 GROUP BY d.Department_Name;\
END;\
\pard\pardeftab720\partightenfactor0
\cf2 \
Execution::\
\
\pard\pardeftab720\sl337\partightenfactor0
\cf3 EXEC Get_Salary_Report_By_Period @PeriodType = 'MONTH';\
\pard\pardeftab720\partightenfactor0
